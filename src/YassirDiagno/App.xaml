<Application x:Class="YassirDiagno.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YassirDiagno"
             xmlns:vm="clr-namespace:YassirDiagno.ViewModels"
             xmlns:views="clr-namespace:YassirDiagno.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemPageViewModel}">
                <views:SystemPageView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HardwarePageViewModel}">
                <views:HardwarePageView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PerformancePageViewModel}">
                <views:PerformancePageView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
                <views:ToolsPageView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsPageViewModel}">
                <views:ReportsPageView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
                <views:SettingsPageView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
