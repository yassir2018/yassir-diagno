<Window x:Class="YassirDiagno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YassirDiagno"
        xmlns:views="clr-namespace:YassirDiagno.Views"
        mc:Ignorable="d"
        Title="Yassir Diagno"
        Height="700" Width="1180"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,18,16,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="32" Height="32">
                            <Rectangle Width="32" Height="32" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E1E2E" Offset="0"/>
                                        <GradientStop Color="#2D2D44" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Path Data="M 10 8 L 16 15 L 22 8" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Line X1="16" Y1="15" X2="16" Y2="24" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Line.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#10B981" Offset="0"/>
                                        <GradientStop Color="#3B82F6" Offset="1"/>
                                    </LinearGradientBrush>
                                </Line.Stroke>
                            </Line>
                        </Canvas>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YASSIR DIAGNO" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Diagnostic · Scan · PC Monitor" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="16,12,16,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0.0" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard" Content="🏠  Accueil"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="System" Content="💻  Système"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Hardware" Content="🔧  Matériel"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Performance" Content="📊  Performance"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Tools" Content="🛠  Outils"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Reports" Content="📄  Rapports"/>
                    <RadioButton Style="{StaticResource SidebarItemStyle}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings" Content="⚙  Paramètres"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentArea" Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
