<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1117"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1D26"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#13161E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3D"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#363B4D"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentGreenLightBrush" Color="#14291F"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentYellowLightBrush" Color="#2D2310"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentRedLightBrush" Color="#2D1414"/>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1D26"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#252937"/>
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#1E293B"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
