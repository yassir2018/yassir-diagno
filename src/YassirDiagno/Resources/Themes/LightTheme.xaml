<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D1D5DB"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#9CA3AF"/>

    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentGreenLightBrush" Color="#F0FDF4"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentYellowLightBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="AccentRedLightBrush" Color="#FEF2F2"/>

    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#EFF6FF"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
