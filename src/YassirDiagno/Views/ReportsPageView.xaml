<UserControl x:Class="YassirDiagno.Views.ReportsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="RAPPORTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Générer et exporter des rapports diagnostic complets" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GenerateCommand}" Content="📋  Générer le rapport" Padding="16,8" FontSize="12" FontWeight="SemiBold"
                        Background="{DynamicResource AccentBlueBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Command="{Binding ExportTextCommand}" Content="💾  Exporter TXT" Padding="14,8" FontSize="11" Margin="8,0,0,0"
                        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                <Button Command="{Binding ExportHtmlCommand}" Content="🌐  Exporter HTML" Padding="14,8" FontSize="11" Margin="8,0,0,0"
                        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,12">
                <TextBox Text="{Binding ReportPreview, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
