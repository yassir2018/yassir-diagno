<Window x:Class="YassirDiagno.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yassir Diagno"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="420" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppFontFamily}">

    <Border CornerRadius="16" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#111827" Opacity="0.22" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Canvas Grid.Column="0" Grid.Row="0" Width="80" Height="80" VerticalAlignment="Center">
                <Rectangle Width="80" Height="80" RadiusX="14" RadiusY="14">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1E2E" Offset="0"/>
                            <GradientStop Color="#2D2D44" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Path Data="M 25 20 L 40 38 L 55 20" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Stroke>
                </Path>
                <Line X1="40" Y1="38" X2="40" Y2="60" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#3B82F6" Offset="1"/>
                        </LinearGradientBrush>
                    </Line.Stroke>
                </Line>
                <Path Data="M 9 51 L 18 51 L 22 45 L 28 60 L 32 42 L 36 51 L 44 51"
                      Stroke="#10B981" StrokeThickness="1.5" Opacity="0.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <Ellipse Canvas.Left="63" Canvas.Top="9" Width="6" Height="6" Fill="#10B981"/>
                <Ellipse Canvas.Left="60" Canvas.Top="6" Width="12" Height="12" Stroke="#10B981" StrokeThickness="1" Opacity="0.4"/>
            </Canvas>

            <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="22,0,0,0">
                <TextBlock Text="Yassir Diagno" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Thermal &amp; Hardware Monitor" FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
                <TextBlock Text="v1.0.0" FontSize="9" Foreground="#9CA3AF" Margin="0,2,0,0"/>
            </StackPanel>

            <TextBlock x:Name="LblStatus" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                       Text="Initialisation..." FontSize="10" Foreground="#6B7280"
                       HorizontalAlignment="Left" Margin="0,16,0,6"/>

            <ProgressBar x:Name="Progress" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                         Height="4" Minimum="0" Maximum="100" Value="0"
                         Foreground="#3B82F6" Background="#E5E7EB" BorderThickness="0"/>
        </Grid>
    </Border>
</Window>
