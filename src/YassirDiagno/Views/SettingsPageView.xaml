<UserControl x:Class="YassirDiagno.Views.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="PARAMÈTRES" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Configuration de l'application" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,18"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="APPARENCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thème sombre" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Bascule entre thème clair et sombre instantanément" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkTheme}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="MONITORING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Intervalle de rafraîchissement" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Durée entre chaque lecture des capteurs (secondes)" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60"
                                     FontSize="13" Padding="8,5" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="s" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding ShowSparklines}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Afficher les mini-graphiques" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Sparklines historiques dans chaque carte du tableau de bord" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding NotificationsEnabled}">
                        <StackPanel>
                            <TextBlock Text="Notifications d'alerte" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Recevoir un toast Windows quand CPU ≥ 85°C ou SSD ≥ 75°C" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DÉMARRAGE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Démarrer avec Windows" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="L'application se lance automatiquement au démarrage du système" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding StartMinimized}">
                        <StackPanel>
                            <TextBlock Text="Démarrer minimisé" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="L'application démarre dans la barre des tâches" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="À PROPOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Version" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="1.0.0" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Framework" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text=".NET 8 / WPF" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sensor library" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="LibreHardwareMonitor 0.9.6" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Command="{Binding SaveCommand}" Content="💾  Sauvegarder" Padding="20,10" FontSize="12" FontWeight="SemiBold"
                        Background="{DynamicResource AccentBlueBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Command="{Binding ResetCommand}" Content="Réinitialiser" Padding="20,10" FontSize="12" Margin="8,0,0,0"
                        Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
                <TextBlock Text="{Binding SaveStatus}" FontSize="11" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
