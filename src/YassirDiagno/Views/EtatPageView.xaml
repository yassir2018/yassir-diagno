<UserControl x:Class="YassirDiagno.Views.EtatPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YassirDiagno.Converters"
             Background="{DynamicResource WindowBackgroundBrush}">
    <UserControl.Resources>
        <conv:HealthStatusToBrushConverter x:Key="StatusBrush"/>
        <conv:HealthStatusToLightBrushConverter x:Key="StatusLightBrush"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="ÉTAT DU SYSTÈME" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Vérification détaillée — métriques, seuils, problèmes identifiés" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding LastUpdate, StringFormat='Mis à jour: {0}'}" FontSize="10" Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="4" Padding="16,14,16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusLightBrush}}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10,8,10,4" Margin="0,0,0,8">
                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding Thresholds}" FontSize="9" Foreground="{DynamicResource TertiaryTextBrush}" Margin="2,0,0,8" TextWrapping="Wrap"
                                           Visibility="{Binding Thresholds, Converter={StaticResource NullToVis}}"/>

                                <Border Background="{Binding Status, Converter={StaticResource StatusLightBrush}}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Verdict}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AccentRedLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="⚠" FontSize="11" Foreground="{DynamicResource AccentRedBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Problem}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentRedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Margin="16,0,0,3" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap">
                                                        <Run Text="Cause:" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Cause}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="16,0,0,0" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap">
                                                        <Run Text="→" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Solution}" FontStyle="Italic"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
