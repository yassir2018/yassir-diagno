<UserControl x:Class="YassirDiagno.Views.PerformancePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="PERFORMANCE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Graphiques historiques temps réel" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Fenêtre :" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="60s" Command="{Binding SelectWindowCommand}" CommandParameter="60" Padding="10,4" FontSize="11"
                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Margin="0,0,4,0"/>
                <Button Content="5min" Command="{Binding SelectWindowCommand}" CommandParameter="300" Padding="10,4" FontSize="11"
                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand" Margin="0,0,4,0"/>
                <Button Content="10min" Command="{Binding SelectWindowCommand}" CommandParameter="600" Padding="10,4" FontSize="11"
                        Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource AccentBlueLightBrush}" CornerRadius="6" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📊" FontSize="11" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding WindowLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="{Binding HistorySeconds, StringFormat='{}{0} points enregistrés'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CPU SILICON" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <TextBlock Text="{Binding CpuStats}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                            <Canvas Height="140" ClipToBounds="True">
                                <Polyline Points="{Binding CpuChart}" Stroke="#3B82F6" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GPU ZONE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <TextBlock Text="{Binding GpuStats}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                            <Canvas Height="140" ClipToBounds="True">
                                <Polyline Points="{Binding GpuChart}" Stroke="#10B981" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SSD" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <TextBlock Text="{Binding SsdStats}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                            <Canvas Height="140" ClipToBounds="True">
                                <Polyline Points="{Binding SsdChart}" Stroke="#06B6D4" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PUISSANCE CPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <TextBlock Text="{Binding PowerStats}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                            <Canvas Height="140" ClipToBounds="True">
                                <Polyline Points="{Binding PowerChart}" Stroke="#F59E0B" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="BATTERIE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TertiaryTextBrush}"/>
                            <TextBlock Text="{Binding BatteryStats}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                            <Canvas Height="140" ClipToBounds="True">
                                <Polyline Points="{Binding BatteryChart}" Stroke="#22C55E" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
