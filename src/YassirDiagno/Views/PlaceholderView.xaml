<UserControl x:Class="YassirDiagno.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="420" Padding="40,32,40,32">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Icon}" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="Section en construction" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Cette section sera disponible dans la prochaine version."
                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                <Border Background="{DynamicResource AccentBlueLightBrush}" CornerRadius="6"
                        Padding="10,5" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="🚧 Bientôt disponible" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
